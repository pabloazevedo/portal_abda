# ============================================================================
# ENVIRONMENT VARIABLES - PRODUCTION
# ============================================================================
# Copie para o servidor como .env (não versionado) e preencha os valores.
# Use com: docker compose up -d --build
#
# NÃO commite este arquivo com senhas reais.

# ============================================================================
# POSTGRES (serviço db do compose)
# ============================================================================
POSTGRES_DB=orchestra_db
POSTGRES_USER=orchestra_user
POSTGRES_PASSWORD=TROQUE_A_SENHA_FORTE

# ============================================================================
# DATABASE / CACHE (app)
# ============================================================================
# A senha abaixo deve ser a mesma de POSTGRES_PASSWORD
DATABASE_URL=postgresql://orchestra_user:TROQUE_A_SENHA_FORTE@db:5432/orchestra_db
REDIS_URL=redis://redis:6379/0

# Porta publicada no host
APP_PORT=8000

# ============================================================================
# SECURITY
# ============================================================================

# Obrigatório em produção — gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 1 = cookies Secure (só atrás de HTTPS / reverse proxy com TLS)
HTTPS_ONLY=1

# Senha do usuário admin criado no primeiro boot (se o banco estiver vazio)
ADMIN_PASSWORD=

# ============================================================================
# AWS S3 (opcional nos primeiros deploys)
# ============================================================================
S3_MODE=local
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_URL_EXPIRY_SECONDS=604800
AWS_S3_PRESIGNED_URL_EXPIRY=900

# ============================================================================
# SMTP (opcional — reset de senha e e-mail de partituras)
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Orchestra Portal <portal@suaorquestra.org>

# ============================================================================
# APP
# ============================================================================
# Versão publicada: arquivo VERSION na raiz do repositório (SemVer).
# Tags Git futuras devem espelhar o mesmo número (ex.: v1.1.0).
# APP_VERSION=1.0.0   # legado — ignorado; use o arquivo VERSION

# ============================================================================
# NOTAS
# ============================================================================
# - Persista volumes: postgres_data, uploads_data
# - Guia: docs/DEPLOY.md
