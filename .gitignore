# =============================================================================
# Portal ABDA — .gitignore
# Versione: código-fonte, templates, migrations, requirements, .env*.example
# NÃO versione: secrets, deps instaladas, builds, DB/logs locais, uploads
# =============================================================================

# ── Secrets / ambiente ───────────────────────────────────────────────────────
.env
.env.*
.envrc
!.env.example
!.env.prod.example
*.pem
*.key
.pypirc
credentials.json
secrets/
*.secret

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
build/
dist/
wheels/
*.whl
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
cover/
.cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# ── Dependências locais (NÃO é source — reinstalar via pip/Docker) ────────────
.python_packages/
.python_packages
.mamba/
.mamba
.pixi/
.pdm-python
.pdm-build/
__pypackages__/

# ── Runtime local sem Docker ─────────────────────────────────────────────────
.pgdata/
.pgdata
.pg.log
.uvicorn.log
.uvicorn.pid
/bin/

# ── Uploads / DB locais ──────────────────────────────────────────────────────
/uploads/*
!/uploads/.gitkeep
*.db
*.sqlite
*.sqlite3
db.sqlite3
db.sqlite3-journal

# ── Mobile (Xcode / Android Studio) ──────────────────────────────────────────
mobile/ios/.build/
mobile/ios/App/.derivedData/
mobile/android/.gradle/
mobile/android/build/
mobile/android/local.properties
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
.idea/
*.iml
.tools/

# ── Frontend (Vite / React SPA) ──────────────────────────────────────────────
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/.vite/
/frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docker / compose overrides locais ────────────────────────────────────────
docker-compose.override.yml
docker-compose*.local.yml

# ── Logs / PIDs / temp ───────────────────────────────────────────────────────
*.log
*.pid
pip-log.txt
pip-delete-this-directory.txt
.moto/
/tmp/
/temp/
.temp/
tempCodeRunnerFile.py

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
.cursor/
.abstra/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Relatórios gerados pelos scanners (Gitleaks, ZAP, Trivy, etc.) ───────────
/security-reports/

# ── Observabilidade / misc ───────────────────────────────────────────────────
*.rdb
*.aof
celerybeat-schedule*
celerybeat.pid
