DATABASE_URL=postgresql://orchestra_user:orchestra_pass@db:5432/orchestra_db

# Chave secreta para assinatura de sessões — gere com: python -c "import secrets; print(secrets.token_hex(32))"
# OBRIGATÓRIO em produção. A aplicação falha na inicialização se não definida.
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-de-64-hex-chars

# Senha do administrador padrão — gerada automaticamente se não definida
# Se não definida, uma senha aleatória é impressa uma vez nos logs de startup.
ADMIN_PASSWORD=

# Desktop Jinja por padrão. Para SPA: SPA_MODULES=home,users ou *
SPA_MODULES=

# ──────────────────────────────────────────────────────────────────
# Fase 1: S3 & Validação de Documentos (Novo)
# ──────────────────────────────────────────────────────────────────

# S3: Modo desenvolvimento (local = mock moto) ou produção (aws = AWS real)
S3_MODE=local

# S3: Configuração
AWS_S3_BUCKET_NAME=portal-partituras-local
AWS_S3_REGION=sa-east-1
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing

# S3: Expiração de URLs (em segundos)
AWS_S3_URL_EXPIRY_SECONDS=604800         # 7 dias
AWS_S3_PRESIGNED_URL_EXPIRY=900          # 15 minutos

# Validação de Documentos
VALIDACAO_ARQUIVO_TIMEOUT_SECONDS=60
VALIDACAO_FUZZY_MATCH_THRESHOLD=80       # Mínimo para fuzzy match (%)
VALIDACAO_SCORE_QUARENTENA=70            # Score mínimo para quarentena (%)
VALIDACAO_SCORE_APROVACAO=90             # Score mínimo para aprovação automática (%)
DOCUMENTO_MAX_SIZE_MB=50                 # Tamanho máximo de arquivo

# Antivírus (ClamAV - opcional)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
